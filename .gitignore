# Xcode
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
# Re-include the nested workspace: git will not descend into a directory
# excluded by the rule above, so the directory must be unexcluded first.
!*.xcodeproj/project.xcworkspace/
*.xcodeproj/project.xcworkspace/*
!*.xcodeproj/project.xcworkspace/contents.xcworkspacedata
!*.xcodeproj/project.xcworkspace/xcshareddata/
*.xcworkspace/*
!*.xcworkspace/contents.xcworkspacedata
!*.xcworkspace/xcshareddata/
DerivedData/
*.xcuserstate
*.xcuserdatad/

# Build products
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
# `Packages/` is not ignored: it holds the local GFCore package's source.
.build/
.swiftpm/

# Derived data from Tools/Demo/seed.sh, which builds into the repo.
build/

# CocoaPods (if used)
Pods/

# macOS
.DS_Store

# Claude Code
# Shared project permissions are tracked; per-machine overrides are not.
.claude/settings.local.json

# Python
__pycache__/

# Demo pipeline working files. The raw backup belongs in ~/GFPCDemoData/,
# outside the repo; these rules are in case a copy lands inside. A raw backup
# exported from a device carries a SIN and photographs of real receipts — see
# Tools/Demo/README.md — and must never be committed.
#
# The scrubbed dataset is the exception and is committed, at
# Tools/Demo/demo-dataset.json. It is the only copy of the demo library that
# is not on one Mac, and the pipeline cannot regenerate a video without it.
# scrub_backup.py --verify is what says it is safe to be there.
GFPCDemoData/
backup-raw.json
