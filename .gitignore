# Xcode
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
# Re-include the nested workspace: git will not descend into a directory
# excluded by the rule above, so the directory must be unexcluded first.
!*.xcodeproj/project.xcworkspace/
*.xcodeproj/project.xcworkspace/*
!*.xcodeproj/project.xcworkspace/contents.xcworkspacedata
!*.xcodeproj/project.xcworkspace/xcshareddata/
*.xcworkspace/*
!*.xcworkspace/contents.xcworkspacedata
!*.xcworkspace/xcshareddata/
DerivedData/
*.xcuserstate
*.xcuserdatad/

# Build products
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
Packages/

# CocoaPods (if used)
Pods/

# macOS
.DS_Store

# Claude Code
# Shared project permissions are tracked; per-machine overrides are not.
.claude/settings.local.json

# Demo pipeline working files. These belong in ~/GFPCDemoData/, outside the
# repo; these rules are in case a copy lands inside. A raw backup exported from
# a device carries a SIN and photographs of real receipts — see
# Tools/Demo/README.md — and must never be committed.
GFPCDemoData/
backup-raw.json
demo-dataset.json
